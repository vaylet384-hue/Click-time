    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        digital: ['Orbitron', 'sans-serif']
                    },
                    colors: {
                        glass: 'rgba(255, 255, 255, 0.08)',
                        glassBorder: 'rgba(255, 255, 255, 0.15)',
                    }
                }
            }
        }
    </script>

    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: #090614;
            min-height: 100vh;
            color: #ffffff;
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
            transition: background 0.5s ease;
        }

        /* Dynamic Themes */
        body.theme-cyber { background: radial-gradient(circle at center, #1a0b36 0%, #080312 100%); }
        body.theme-space { background: radial-gradient(circle at center, #051923 0%, #000814 100%); }
        body.theme-sunset { background: radial-gradient(circle at center, #2b0927 0%, #0f0210 100%); }
        body.theme-emerald { background: radial-gradient(circle at center, #062c22 0%, #010d0a 100%); }

        /* Glassmorphism */
        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .glass-btn {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.03));
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .glass-btn:active {
            transform: scale(0.96);
        }

        /* Ripple Effect */
        .ripple-container {
            position: relative;
            overflow: hidden;
        }

        .ripple {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(0, 240, 255, 0.7) 0%, rgba(112, 0, 255, 0.2) 70%, transparent 100%);
            transform: scale(0);
            animation: ripple-effect 0.6s linear;
            pointer-events: none;
        }

        @keyframes ripple-effect {
            to {
                transform: scale(4);
                opacity: 0;
            }
        }

        /* Click Particles */
        .click-particle {
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            font-weight: 800;
            font-size: 1.5rem;
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.8), 0 0 20px rgba(112, 0, 255, 0.8);
            animation: float-up 0.8s ease-out forwards;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        @keyframes float-up {
            0% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(0.8) translateY(0);
            }
            50% {
                transform: translate(-50%, -50%) scale(1.2) translateY(-30px);
            }
            100% {
                opacity: 0;
                transform: translate(-50%, -50%) scale(1) translateY(-60px);
            }
        }

        /* Custom Watch Frame Rings */
        .frame-neon { border-color: #00f0ff !important; box-shadow: 0 0 35px rgba(0, 240, 255, 0.6); }
        .frame-gold { border-color: #ffd700 !important; box-shadow: 0 0 35px rgba(255, 215, 0, 0.6); }
        .frame-plasma { border-color: #ff007f !important; box-shadow: 0 0 35px rgba(255, 0, 127, 0.6); }
        .frame-emerald { border-color: #10b981 !important; box-shadow: 0 0 35px rgba(16, 185, 129, 0.6); }

        /* Energy indicator shaking when empty */
        .shake-energy {
            animation: shake 0.3s ease-in-out;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-4px); }
            40%, 80% { transform: translateX(4px); }
        }

        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }
    </style>
</head>
